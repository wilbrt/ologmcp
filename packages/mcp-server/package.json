{
  "name": "@olog/mcp-server",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "bin": {
    "olog-mcp": "./dist/index.js",
    "olog-mcp-mining": "./dist/index-mining.js"
  },
  "dependencies": {
    "@olog/core": "*",
    "@olog/lang-typescript": "*",
    "@olog/lang-clojure": "*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "tsup": "^8.3.5"
  },
  "scripts": {
    "build": "tsup && cp ../core/src/schema.sql dist/ && rm -rf dist/queries && cp -r ../core/src/ingest/queries dist/queries",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No tests yet\"",
    "dot": "tsx src/scripts/dot.ts",
    "dot:svg": "tsx src/scripts/dot.ts | dot -Tsvg -o olog.svg && open olog.svg"
  }
}