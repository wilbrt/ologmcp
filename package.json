{
  "name": "olog-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "clean": "npm run clean --workspaces",
    "dot": "OLOG_ROOT=$PWD npm run dot --workspace=packages/mcp-server",
    "dot:svg": "OLOG_ROOT=$PWD npm run dot:svg --workspace=packages/mcp-server"
  }
}