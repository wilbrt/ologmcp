{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@angdrew/opencode-hashline-plugin"
  ],
  "mcp": {
    "olog": {
      "type": "local",
      "command": [
        "./run-olog-mcp.sh"
      ],
      "enabled": true,
      "environment": {
        "OLOG_LANGUAGES": "typescript"
      }
    },
    "olog-mining": {
      "type": "local",
      "command": [
        "./run-olog-mining-mcp.sh"
      ],
      "enabled": true,
      "environment": {
        "OLOG_LANGUAGES": "typescript"
      }
    },
    "olog-ws-assert": {
      "type": "local",
      "command": [
        "./run-olog-ws-assert-mcp.sh"
      ],
      "enabled": true
    }
  }
}
